# ─────────────────────────────────────────────────────────────────────────────
# PupputGate — environment template. Copy to `.env` and fill in. NEVER commit .env
# ─────────────────────────────────────────────────────────────────────────────

# MOBILE APP (Expo) ───────────────────────────────────────────────────────────
# Optional. If unset, the app auto-derives the API URL from the Expo packager
# host (your dev machine's LAN IP) — this is what makes Expo Go work on a phone.
# Set it only if your API runs somewhere else, e.g.:
# EXPO_PUBLIC_API_URL=http://192.168.1.10:4000

# Google Maps Android key. ONLY used by a dev/prod build (npx expo run:android /
# EAS). In Expo Go the map uses Expo Go's own bundled key, so this can stay empty
# while developing in Expo Go.
GOOGLE_MAPS_ANDROID_KEY=

# BACKEND (server/) ───────────────────────────────────────────────────────────
# Postgres connection string.
DATABASE_URL=postgresql://pupput:pupput@localhost:5432/pupputgate?schema=public

# Port the API listens on.
PORT=4000

# Secret used to sign/derive opaque token material. Generate a long random value.
AUTH_TOKEN_SECRET=change-me-to-a-long-random-string

# Comma-separated CORS origins (not required for the native app; leave default).
CORS_ORIGINS=

# Bootstrap admin (seeded). Demo only.
ADMIN_EMAIL=admin@pupputgate.demo
