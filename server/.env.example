# Copy to server/.env and fill in. NEVER commit server/.env

# Postgres connection (matches docker-compose.yml defaults)
DATABASE_URL=postgresql://pupput:pupput@localhost:5432/pupputgate?schema=public

# API port
PORT=4000

# Long random secret used to key the opaque-token hash. Generate your own.
AUTH_TOKEN_SECRET=change-me-to-a-long-random-string

# Optional CORS origins (not needed for the native app)
CORS_ORIGINS=
